<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Recall.Benchmarks</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RecallEmbedRequireNative>true</RecallEmbedRequireNative>
  </PropertyGroup>
  <Import Project="..\..\native\RecallEmbed.Native.props" />
  <ItemGroup>
    <Content Include="@(RecallEmbedNativeDlls)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <ProjectReference Include="..\Recall.Core\Recall.Core.csproj" />
    <ProjectReference Include="..\Recall.Adapters\Recall.Adapters.csproj" />
  </ItemGroup>
</Project>
