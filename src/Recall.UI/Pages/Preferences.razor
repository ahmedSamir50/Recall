@page "/preferences"
@inherits RecallComponentBase

<div class="p-4 md:p-6 max-w-640">
    <h1 class="f-head font-semibold text-22 mb-6">@T("Preferences_Title")</h1>
    <div class="g2 rounded-2xl p-5 flex flex-col gap-4">
        <div>
            <p class="lbl mb-2">@T("Preferences_Theme")</p>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn btn-g" @onclick="() => SetTheme(ThemePreference.System)">@T("Theme_System")</button>
                <button type="button" class="btn btn-g" @onclick="() => SetTheme(ThemePreference.Dark)">@T("Theme_Dark")</button>
                <button type="button" class="btn btn-g" @onclick="() => SetTheme(ThemePreference.Light)">@T("Theme_Light")</button>
            </div>
        </div>
        <div>
            <p class="lbl mb-2">@T("Preferences_Language")</p>
            <ThemeLanguageToggles />
        </div>
        <div>
            <p class="lbl mb-2">@T("Preferences_Age")</p>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn @(age == AgeCutoffYears.Two ? "btn-p" : "btn-g")" @onclick="() => SetAge(AgeCutoffYears.Two)">@D("2")</button>
                <button type="button" class="btn @(age == AgeCutoffYears.Five ? "btn-p" : "btn-g")" @onclick="() => SetAge(AgeCutoffYears.Five)">@D("5")</button>
                <button type="button" class="btn @(age == AgeCutoffYears.Seven ? "btn-p" : "btn-g")" @onclick="() => SetAge(AgeCutoffYears.Seven)">@D("7")</button>
            </div>
            <p class="text-13 ink3 mt-2">@T("Preferences_AgeLead")</p>
        </div>
        <div class="flex flex-col gap-2">
            <button type="button" class="btn btn-g text-start" @onclick="GoDevice">@T("Preferences_DeviceLink")</button>
            <button type="button" class="btn btn-g text-start" @onclick="GoPin">@T("Preferences_PinLink")</button>
            <button type="button" class="btn btn-g text-start" @onclick="GoFolders">@T("Preferences_FoldersLink")</button>
            <button type="button" class="btn btn-g text-start" @onclick="GoModels">@T("Preferences_ModelsLink")</button>
        </div>
        <button type="button" class="btn btn-g er text-start" disabled>@T("Preferences_DeleteIndex")</button>
    </div>
</div>
