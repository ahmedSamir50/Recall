@namespace Recall.UI.Pages
@page "/lattice"
@inherits RecallComponentBase

<div class="p-4 md:p-6 h-full flex flex-col">
    <div class="flex items-end justify-between mb-4">
        <div>
            <p class="lbl mb-1">@T("Lattice_Kicker")</p>
            <h1 class="f-head font-semibold text-22">@T("Lattice_Title")</h1>
        </div>
        <p class="text-12 ink3 hidden md:block">@T("Lattice_SyncStub")</p>
    </div>
    <div class="g2 rounded-2xl flex-1 min-h-[420px] relative overflow-hidden" dir="ltr">
        <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            @foreach (var node in Nodes.Skip(1))
            {
                <line x1="50" y1="50" x2="@node.X" y2="@node.Y" stroke="var(--line-2)" stroke-width="0.25" vector-effect="non-scaling-stroke" />
            }
        </svg>
        @foreach (var node in Nodes)
        {
            <div class="absolute lattice-node flex flex-col items-center gap-2" style="left:@(node.X)%;top:@(node.Y)%">
                <span class="@node.ColorClass rounded-full block lattice-glow" style="width:@(node.Radius * 2)px;height:@(node.Radius * 2)px;background:currentColor"></span>
                @if (node.Label is not null)
                {
                    <span class="pill text-11 f-mono g1 ink">@node.Label</span>
                }
            </div>
        }
    </div>
</div>
