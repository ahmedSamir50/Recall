@namespace Recall.UI.Pages
@page "/"
@inherits RecallComponentBase
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Recall.Core.Scope
@using Recall.Core.Ingest

<div class="px-3 md:px-6 pt-4 md:pt-6 max-w-1500 mx-auto">
    <div class="g3 rounded-2xl p-2 flex flex-wrap sm:flex-nowrap items-center gap-2 mb-6">
        <div class="flex p-1 rounded-xl" style="background:var(--c1)" role="tablist">
            <span class="h-10 px-3 rounded-lg text-13 font-medium btn-p flex items-center gap-2" role="tab" aria-selected="true">
                <RecallIcon Name="search" Css="w-4 h-4 hidden md:block" />@T("Mode_Find")
            </span>
        </div>
        <div class="order-first sm:order-none basis-full sm:basis-auto flex-1 min-w-0 px-2 py-2 flex items-center min-h-10 search-field" role="search">
            <input @bind="query" @bind:event="oninput" aria-label="@T("Search_Placeholder")" placeholder="@T("Search_Placeholder")" @onkeydown="OnKeyDownAsync" class="w-full search-input" />
        </div>
    </div>
    @if (ingestRows.Count > 0)
    {
        <section class="g2 rounded-2xl p-4 max-w-640 mx-auto mb-4">
            <h2 class="font-semibold text-16 mb-3">@T("Ingest_Heading")</h2>
            @foreach (var row in ingestRows)
            {
                <p class="text-13 ink2 mb-1"><span>@T(IngestKindLabel(row.Kind))</span> <span class="ltr">@row.Finished/@row.Seen @row.Percent%</span></p>
            }
        </section>
    }
    @if (ShowPictureControl)
    {
    <section class="g2 rounded-2xl p-4 max-w-640 mx-auto mb-4">
        <InputFile id="picture-input" class="hidden" OnChange="OnPictureSelectedAsync" accept="@PictureAccept" />
        <label class="btn btn-g inline-flex" for="picture-input">@T("Search_WithPicture")</label>
        @if (pictureKey is not null)
        {
            <p class="ink2 text-13 mt-2">@T(pictureKey)</p>
        }
        @foreach (var hit in pictureHits)
        {
            <div class="flex items-center gap-2 mt-2">
                <span class="ltr flex-1 min-w-0 truncate"><bdi class="ltr">@hit.SourcePath</bdi></span>
                <span class="ink2 text-13"><bdi class="ltr">@FormatSeconds(hit.StartSeconds)–@FormatSeconds(hit.EndSeconds)</bdi></span>
                <button type="button" class="btn btn-g" @onclick="() => OpenHitAsync(hit)">@T("Home_OpenFile")</button>
            </div>
        }
    </section>
    }
    @if (ShowAudioControl)
    {
    <section class="g2 rounded-2xl p-4 max-w-640 mx-auto mb-4">
        <InputFile id="audio-input" class="hidden" OnChange="OnAudioSelectedAsync" accept="@MediaFileKinds.AudioAccept" />
        <label class="btn btn-g inline-flex" for="audio-input">@T("Search_WithAudio")</label>
        @if (AudioOff.Shown)
        {
            <p class="ink2 text-13 mt-2">@T("Search_AudioOff")</p>
        }
        @if (audioKey is not null)
        {
            <p class="ink2 text-13 mt-2">@T(audioKey)</p>
        }
        @foreach (var hit in audioHits)
        {
            <div class="flex items-center gap-2 mt-2">
                <span class="ltr flex-1 min-w-0 truncate"><bdi class="ltr">@hit.SourcePath</bdi></span>
                <span class="ink2 text-13"><bdi class="ltr">@FormatSeconds(hit.StartSeconds)–@FormatSeconds(hit.EndSeconds)</bdi></span>
                <button type="button" class="btn btn-g" @onclick="() => OpenHitAsync(hit)">@T("Home_OpenFile")</button>
            </div>
        }
    </section>
    }
    @if (IndexNowPanel.ShouldShow(offers))
    {
        <section class="g2 rounded-2xl p-4 max-w-640 mx-auto mb-4">
            <p class="ink2 text-13 mb-2">@T("Home_IndexNowLead")</p>
            @foreach (var grant in offers)
            {
                <div class="flex items-center gap-2 mb-2">
                    <bdi class="ltr">@grant.DisplayName</bdi>
                    <button type="button" class="btn btn-g" @onclick="() => IndexNowAsync(grant.Path)">@T("Home_IndexNow")</button>
                </div>
            }
        </section>
    }
    @if (!TextFindSession.ShouldQuery(query) || !hasSearched)
    {
        <section class="g2 rounded-2xl p-8 md:p-12 text-center rise max-w-640 mx-auto">
            <RecallIcon Name="search" Css="w-10 h-10 mx-auto mb-4 cy" />
            <h1 class="f-head font-semibold text-22 mb-2">@T("Search_EmptyTitle")</h1>
            <p class="ink2 text-15">@T("Search_EmptyLead")</p>
        </section>
    }
    else
    {
        @if (faultKey is not null)
        {
            <section class="g2 rounded-2xl p-8 md:p-12 text-center rise max-w-640 mx-auto">
                <p class="ink2 text-15">@T(faultKey)</p>
            </section>
        }
        else if (!view.HasHits)
        {
            <section class="g2 rounded-2xl p-8 md:p-12 text-center rise max-w-640 mx-auto">
                <h1 class="f-head font-semibold text-22 mb-2">@T("Search_NoHitsTitle")</h1>
                <p class="ink2 text-15">@T("Search_NoHitsLead")</p>
            </section>
        }
        else
        {
            <section class="flex flex-col gap-2 max-w-640 mx-auto">
                @if (RemoteSkips.SkippedCount > 0)
                {
                    <p class="ink2 text-13"><bdi class="ltr">@T("Search_SkipRemoteLine")</bdi></p>
                }
                @foreach (var folder in DatasetSkips.Paths)
                {
                    <p class="ink2 text-13"><bdi class="ltr">@T("Search_SkipDatasetLine") @folder</bdi></p>
                }
                @foreach (var card in view.Immediate)
                {
                    <article class="g2 rounded-2xl p-4">
                        <p class="lbl mb-1">@T(card.KindKey)</p>
                        <h2 class="font-semibold text-16 mb-1">@card.FileName</h2>
                        <p class="ink2 text-13 mb-1"><bdi class="ltr">@card.LocalTime</bdi></p>
                        <p class="ink2 text-13 mb-2">@T(card.ReasonKey)</p>
                        @if (!string.IsNullOrWhiteSpace(card.RawNote))
                        {
                            <p class="ink2 text-13 mb-2">@card.RawNote</p>
                        }
                        @if (card.Unavailable)
                        {
                            <p class="font-medium text-14">@T("Home_UnavailTitle")</p>
                            <p class="ink2 text-13">@T("Home_UnavailLead")</p>
                        }
                        else
                        {
                            <button type="button" class="btn btn-g" @onclick="() => OpenAsync(card)">@T("Home_OpenFile")</button>
                        }
                    </article>
                }
                <Virtualize Items="view.Deferred.ToList()" Context="card">
                    <article class="g2 rounded-2xl p-4">
                        <p class="lbl mb-1">@T(card.KindKey)</p>
                        <h2 class="font-semibold text-16 mb-1">@card.FileName</h2>
                        <p class="ink2 text-13 mb-1"><bdi class="ltr">@card.LocalTime</bdi></p>
                        <p class="ink2 text-13 mb-2">@T(card.ReasonKey)</p>
                        @if (!string.IsNullOrWhiteSpace(card.RawNote))
                        {
                            <p class="ink2 text-13 mb-2">@card.RawNote</p>
                        }
                        @if (card.Unavailable)
                        {
                            <p class="font-medium text-14">@T("Home_UnavailTitle")</p>
                            <p class="ink2 text-13">@T("Home_UnavailLead")</p>
                        }
                        else
                        {
                            <button type="button" class="btn btn-g" @onclick="() => OpenAsync(card)">@T("Home_OpenFile")</button>
                        }
                    </article>
                </Virtualize>
            </section>
        }
    }
</div>
