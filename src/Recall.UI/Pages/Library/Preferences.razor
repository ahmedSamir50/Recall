@namespace Recall.UI.Pages
@page "/preferences"
@inherits RecallComponentBase

<div class="p-4 md:p-6 flex justify-center">
<div class="w-full max-w-640">
    <h1 class="f-head font-semibold text-22 mb-6">@T("Preferences_Title")</h1>
    <div class="g2 rounded-2xl p-5 flex flex-col gap-4">
        <div>
            <p class="lbl mb-2">@T("Preferences_Theme")</p>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn @ThemeChoiceClass(Ui.Current.ThemePreference, ThemePreference.System)" aria-pressed="@IsThemeSelected(Ui.Current.ThemePreference, ThemePreference.System)" @onclick="() => SetTheme(ThemePreference.System)">@T("Theme_System")</button>
                <button type="button" class="btn @ThemeChoiceClass(Ui.Current.ThemePreference, ThemePreference.Dark)" aria-pressed="@IsThemeSelected(Ui.Current.ThemePreference, ThemePreference.Dark)" @onclick="() => SetTheme(ThemePreference.Dark)">@T("Theme_Dark")</button>
                <button type="button" class="btn @ThemeChoiceClass(Ui.Current.ThemePreference, ThemePreference.Light)" aria-pressed="@IsThemeSelected(Ui.Current.ThemePreference, ThemePreference.Light)" @onclick="() => SetTheme(ThemePreference.Light)">@T("Theme_Light")</button>
            </div>
        </div>
        <div>
            <p class="lbl mb-2">@T("Preferences_Language")</p>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn @(Ui.Current.Locale == UiLocale.En ? "btn-p" : "btn-g")" aria-pressed="@(Ui.Current.Locale == UiLocale.En)" @onclick="() => SetLocale(UiLocale.En)">@T("Language_TargetEnglish")</button>
                <button type="button" class="btn @(Ui.Current.Locale == UiLocale.Ar ? "btn-p" : "btn-g")" aria-pressed="@(Ui.Current.Locale == UiLocale.Ar)" @onclick="() => SetLocale(UiLocale.Ar)">@T("Language_TargetArabic")</button>
            </div>
        </div>
        <div>
            <p class="lbl mb-2">@T("Preferences_Age")</p>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="btn @(age == AgeCutoffYears.Two ? "btn-p" : "btn-g")" @onclick="() => SetAge(AgeCutoffYears.Two)">2</button>
                <button type="button" class="btn @(age == AgeCutoffYears.Five ? "btn-p" : "btn-g")" @onclick="() => SetAge(AgeCutoffYears.Five)">5</button>
                <button type="button" class="btn @(age == AgeCutoffYears.Seven ? "btn-p" : "btn-g")" @onclick="() => SetAge(AgeCutoffYears.Seven)">7</button>
            </div>
            <p class="text-13 ink3 mt-2">@T("Preferences_AgeLead")</p>
        </div>
        <div>
            <p class="lbl mb-2">@T("Skips_Heading")</p>
            <p class="text-13 ink3 mb-3">@T("Skips_Note")</p>
            <div class="flex flex-col gap-4">
                <div>
                    <p class="lbl mb-2">@T("Skips_CodeExtensions")</p>
                    <p class="text-13 ink3 mb-2">@T("Skips_CodeIndexed")</p>
                    <ul class="plain-list flex flex-col gap-1 mb-2">
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.CodeExtensions)
                        {
                            <li class="text-13 ink2">@row</li>
                        }
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.ExactCodeNames)
                        {
                            <li class="text-13 ink2">@row</li>
                        }
                        @foreach (var row in skips.Extensions)
                        {
                            <li class="text-13 ink2 flex items-center justify-between gap-2"><span>@row</span><button type="button" class="btn btn-g" @onclick="() => RemoveExtension(row)">@T("Skips_Remove")</button></li>
                        }
                    </ul>
                    <div class="flex gap-2">
                        <input class="inp flex-1" value="@extensionDraft" @onchange="e => extensionDraft = e.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="btn btn-g" @onclick="ApplyExtension">@T("Skips_Add")</button>
                    </div>
                    @if (extensionNotice is not null)
                    {
                        <p class="text-13 ink3 mt-2">@T(extensionNotice)</p>
                    }
                </div>
                <div>
                    <p class="lbl mb-2">@T("Skips_Folders")</p>
                    <ul class="plain-list flex flex-col gap-1 mb-2">
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.SkipFolders)
                        {
                            <li class="text-13 ink2">@row</li>
                        }
                        @foreach (var row in skips.FolderNames)
                        {
                            <li class="text-13 ink2 flex items-center justify-between gap-2"><span>@row</span><button type="button" class="btn btn-g" @onclick="() => RemoveFolder(row)">@T("Skips_Remove")</button></li>
                        }
                    </ul>
                    <div class="flex gap-2">
                        <input class="inp flex-1" value="@folderDraft" @onchange="e => folderDraft = e.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="btn btn-g" @onclick="ApplyFolder">@T("Skips_Add")</button>
                    </div>
                    @if (folderNotice is not null)
                    {
                        <p class="text-13 ink3 mt-2">@T(folderNotice)</p>
                    }
                </div>
                <div>
                    <p class="lbl mb-2">@T("Skips_Secrets")</p>
                    <ul class="plain-list flex flex-col gap-1 mb-2">
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.SecretExtensions)
                        {
                            <li class="text-13 ink2">.@row</li>
                        }
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.SecretNames)
                        {
                            <li class="text-13 ink2">@row</li>
                        }
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.DatabaseExtensions)
                        {
                            <li class="text-13 ink2">.@row</li>
                        }
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.LockNames)
                        {
                            <li class="text-13 ink2">@row</li>
                        }
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.MinifiedSuffixes)
                        {
                            <li class="text-13 ink2">@row</li>
                        }
                        @foreach (var row in Recall.Core.Scope.BuiltInSkips.SecretDisplayRows)
                        {
                            <li class="text-13 ink2">@row</li>
                        }
                        @foreach (var row in skips.FileNames)
                        {
                            <li class="text-13 ink2 flex items-center justify-between gap-2"><span>@row</span><button type="button" class="btn btn-g" @onclick="() => RemoveFile(row)">@T("Skips_Remove")</button></li>
                        }
                    </ul>
                    <div class="flex gap-2">
                        <input class="inp flex-1" value="@fileDraft" @onchange="e => fileDraft = e.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="btn btn-g" @onclick="ApplyFile">@T("Skips_Add")</button>
                    </div>
                    @if (fileNotice is not null)
                    {
                        <p class="text-13 ink3 mt-2">@T(fileNotice)</p>
                    }
                </div>
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <button type="button" class="btn btn-g text-start" @onclick="GoDevice">@T("Preferences_DeviceLink")</button>
            <button type="button" class="btn btn-g text-start" @onclick="GoPin">@T("Preferences_PinLink")</button>
            <button type="button" class="btn btn-g text-start" @onclick="GoFolders">@T("Preferences_FoldersLink")</button>
            <button type="button" class="btn btn-g text-start" @onclick="GoModels">@T("Preferences_ModelsLink")</button>
        </div>
        <button type="button" class="btn btn-g er text-start" disabled>@T("Preferences_DeleteIndex")</button>
        @if (DebugReset.IsEnabled)
        {
            <div class="border-t bd pt-4 mt-2">
                <p class="lbl mb-2">@T("Debug_ResetAll_Label")</p>
                <p class="text-13 ink3 mb-3">@T("Debug_ResetAll_Lead")</p>
                <button type="button" class="btn btn-g er text-start w-full" @onclick="ResetAllDebugAsync">@T("Debug_ResetAll_Button")</button>
            </div>
        }
    </div>
</div>
</div>
