@namespace Recall.UI.Pages
@page "/device"
@inherits RecallComponentBase

<div class="p-4 md:p-6 max-w-640 mx-auto">
    <h1 class="f-head font-semibold text-22 mb-2">@T("Device_Title")</h1>
    <p class="ink2 mb-6">@T("Device_Lead")</p>
    <div class="g2 rounded-2xl p-5 flex flex-col gap-4">
        <div>
            <p class="lbl mb-2">@T("Device_DisplayNameLabel")</p>
            <input type="text" class="w-full rounded-xl border bd px-3 py-2 text-15 field-input" @bind="displayName" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(displayNameError))
            {
                <p class="text-13 er mt-2">@displayNameError</p>
            }
            <button type="button" class="btn btn-p mt-3" @onclick="SaveDisplayName">@T("Device_Save")</button>
        </div>
        <div>
            <p class="lbl mb-1">@T("Device_OriginalNameLabel")</p>
            <p class="ink2 text-15">@(string.IsNullOrEmpty(originalName) ? T("Device_Title") : originalName)</p>
        </div>
        <div>
            <p class="lbl mb-1">@T("Device_IdLabel")</p>
            <bdi class="ltr f-mono text-12 ink3 break-all">@deviceId</bdi>
            @if (!string.IsNullOrEmpty(deviceIdError))
            {
                <p class="text-13 er mt-2">@deviceIdError</p>
            }
        </div>
    </div>
</div>
