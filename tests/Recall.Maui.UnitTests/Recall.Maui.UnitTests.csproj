<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Recall.Maui.UnitTests</RootNamespace>
    <AssemblyName>Recall.Maui.UnitTests</AssemblyName>
    <OutputType>Exe</OutputType>
    <UseWinExe>false</UseWinExe>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <ProjectReference Include="..\..\src\Recall.Maui\Recall.Maui.csproj" />
    <ProjectReference Include="..\Recall.IntegrationTests\Recall.IntegrationTests.csproj" />
    <ProjectReference Include="..\Recall.UnitTests\Recall.UnitTests.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Recall.IntegrationTests\Fixtures\**\*" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestAssets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="TestAssets" />
    <Content Include="..\Recall.IntegrationTests\Fixtures\talk.m4a" Link="talk.m4a" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Recall.IntegrationTests\Fixtures\talk.m4a')" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWinExe>false</UseWinExe>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
</Project>
