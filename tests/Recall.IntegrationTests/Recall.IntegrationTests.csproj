<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinExe>false</UseWinExe>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RootNamespace>Recall.IntegrationTests</RootNamespace>
    <AssemblyName>Recall.IntegrationTests</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(RunIntegrationTests)' == 'true'">true</IsTestProject>
    <IsTestProject Condition="'$(RunIntegrationTests)' != 'true'">false</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RecallEmbedRequireNative>true</RecallEmbedRequireNative>
  </PropertyGroup>
  <Import Project="..\..\native\RecallEmbed.Native.props" />
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TestAssets\embeddinggemma-2-text\embeddinggemma-2-Q8_0.gguf" CopyToOutputDirectory="PreserveNewest" Link="TestAssets\embeddinggemma-2-text\embeddinggemma-2-Q8_0.gguf" Condition="Exists('TestAssets\embeddinggemma-2-text\embeddinggemma-2-Q8_0.gguf')" />
    <Content Include="TestAssets\embeddinggemma-2-vision\mmproj-embeddinggemma-2-Q8_0.gguf" CopyToOutputDirectory="PreserveNewest" Link="TestAssets\embeddinggemma-2-vision\mmproj-embeddinggemma-2-Q8_0.gguf" Condition="Exists('TestAssets\embeddinggemma-2-vision\mmproj-embeddinggemma-2-Q8_0.gguf')" />
    <Content Include="..\Recall.Maui.UnitTests\TestAssets\models\ocr\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="TestAssets\models\ocr" />
    <Content Include="..\Recall.Maui.UnitTests\TestAssets\ocr-fixtures\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="TestAssets\ocr-fixtures" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="@(RecallEmbedNativeDlls)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="ZVec.NET" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="UglyToad.PdfPig" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\..\src\Recall.Adapters\Recall.Adapters.csproj" />
    <ProjectReference Include="..\..\src\Recall.Core\Recall.Core.csproj" />
    <ProjectReference Include="..\..\src\Recall.Maui\Recall.Maui.csproj" />
    <ProjectReference Include="..\Recall.UnitTests\Recall.UnitTests.csproj" />
  </ItemGroup>
</Project>
