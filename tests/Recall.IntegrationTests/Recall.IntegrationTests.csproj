<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Recall.IntegrationTests</RootNamespace>
    <AssemblyName>Recall.IntegrationTests</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RecallEmbedRequireNative>true</RecallEmbedRequireNative>
  </PropertyGroup>
  <Import Project="..\..\native\RecallEmbed.Native.props" />
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TestAssets\embeddinggemma-2-text\embeddinggemma-2-Q8_0.gguf" CopyToOutputDirectory="PreserveNewest" Link="TestAssets\embeddinggemma-2-text\embeddinggemma-2-Q8_0.gguf" Condition="Exists('TestAssets\embeddinggemma-2-text\embeddinggemma-2-Q8_0.gguf')" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="@(RecallEmbedNativeDlls)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="ZVec.NET" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\..\src\Recall.Adapters\Recall.Adapters.csproj" />
    <ProjectReference Include="..\..\src\Recall.Core\Recall.Core.csproj" />
  </ItemGroup>
</Project>
